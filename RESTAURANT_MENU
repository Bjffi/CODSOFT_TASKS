<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Restaurant Menu</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f8f8f8;
        }

        header {
            background-color: #d35400;
            color: white;
            text-align: center;
            padding: 20px;
        }

        h1 {
            margin: 0;
        }

        .container {
            max-width: 1000px;
            margin: auto;
            padding: 20px;
        }

        .category {
            margin-bottom: 40px;
        }

        .category h2 {
            border-bottom: 3px solid #d35400;
            padding-bottom: 5px;
            color: #333;
        }

        .menu-items {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .item {
            background: white;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            transition: 0.3s;
        }

        .item:hover {
            transform: scale(1.05);
        }

        .item h3 {
            margin: 0;
        }

        .price {
            color: #d35400;
            font-weight: bold;
            margin-top: 5px;
        }

        .btn {
            display: inline-block;
            margin-top: 10px;
            padding: 8px 15px;
            background: #d35400;
            color: white;
            text-decoration: none;
            border-radius: 5px;
        }

        footer {
            text-align: center;
            padding: 15px;
            background: #333;
            color: white;
        }

        @media (max-width: 600px) {
            header {
                font-size: 18px;
            }
        }
    </style>
</head>

<body>

<header>
    <h1>Delicious Bites 🍽️</h1>
    <p>FOR DEMO CLICK HERE</p>
</header>

<div class="container">

    <!-- Starters -->
    <div class="category">
        <h2>Starters</h2>
        <div class="menu-items">
            <div class="item">
                <h3>Veg Spring Rolls</h3>
                <p>Crispy rolls stuffed with vegetables.</p>
                <div class="price">₹120</div>
                <a href="#" class="btn">Order Now</a>
            </div>

            <div class="item">
                <h3>Chicken 65</h3>
                <p>Spicy deep-fried chicken bites.</p>
                <div class="price">₹180</div>
                <a href="#" class="btn">Order Now</a>
            </div>
        </div>
    </div>

    <!-- Main Course -->
    <div class="category">
        <h2>Main Course</h2>
        <div class="menu-items">
            <div class="item">
                <h3>Paneer Butter Masala</h3>
                <p>Rich creamy tomato-based curry.</p>
                <div class="price">₹220</div>
                <a href="#" class="btn">Order Now</a>
            </div>

            <div class="item">
                <h3>Chicken Biryani</h3>
                <p>Flavorful basmati rice with spices.</p>
                <div class="price">₹250</div>
                <a href="#" class="btn">Order Now</a>
            </div>
        </div>
    </div>

    <!-- Desserts -->
    <div class="category">
        <h2>Desserts</h2>
        <div class="menu-items">
            <div class="item">
                <h3>Gulab Jamun</h3>
                <p>Soft sweet dumplings in sugar syrup.</p>
                <div class="price">₹90</div>
                <a href="#" class="btn">Order Now</a>
            </div>

            <div class="item">
                <h3>Ice Cream</h3>
                <p>Vanilla / Chocolate scoop.</p>
                <div class="price">₹80</div>
                <a href="#" class="btn">Order Now</a>
            </div>
        </div>
    </div>

</div>

<footer>
    © 2026 Delicious Bites | All Rights Reserved
</footer>

</body>
</html>
